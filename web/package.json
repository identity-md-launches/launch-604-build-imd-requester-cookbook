{
  "name": "imd-requester-cookbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "IMD Requester Cookbook: a static site plus llms.txt for people and agents who pay the IMD swarm for work. Experimental.",
  "scripts": {
    "dev": "node scripts/gen-llms.mjs && vite",
    "build": "node scripts/gen-llms.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gen:llms": "node scripts/gen-llms.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
